{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "korin",
      "camelcase": "Korin",
      "title": "Korin",
      "scope": "source.korin",
      "file-types": [
        "korin"
      ],
      "injection-regex": "^korin$",
      "class-name": "TreeSitterKorin",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.1",
    "license": "Apache-2.0",
    "description": "Korin wizard files for tree-sitter",
    "links": {
      "repository": "https://github.com/zerodahero/tree-sitter-korin"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false
  }
}
